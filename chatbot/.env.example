# Copie para .env e ajuste se quiser (cp .env.example .env). Tudo é opcional.

# Porta em que o chat fica disponível no servidor
PORTA=8000

# Modelo que escreve as respostas e modelo que faz a busca nos documentos
CHAT_MODEL=phi4-mini
EMBED_MODEL=bge-m3

# Quantos trechos da documentação vão junto com cada pergunta
TOP_K=5
# Criatividade das respostas (0 = mais previsível)
TEMPERATURE=0.2
# Tamanho da janela de contexto do modelo, em tokens
NUM_CTX=8192
# Quanto tempo o modelo fica carregado na memória depois do último uso (-1 = sempre)
KEEP_ALIVE=60m

# "Raciocínio" de modelos como o qwen3 (false = mais rápido). Deixe comentado para o phi4-mini.
# THINK=false

# Modelos extras para comparação, escolhidos por pergunta pela API (baixados automaticamente)
# MODELOS_TESTE=qwen3:14b,gemma3:12b

# Filtro de assunto (SIM/NÃO antes de responder). false = desliga
# FILTRO_ASSUNTO=true
