# Copie este arquivo para .env (na mesma pasta) e preencha.
# O .env fica fora do Git: a chave da TTN não pode ir para o repositório.

# ID da aplicação na TTN (aparece no topo da página da aplicação no console)
TTN_APP_ID=sua-aplicacao

# Chave de API com o direito "Read application traffic (uplink and downlink)"
TTN_API_KEY=NNSXS.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Cluster da TTN onde a aplicação foi criada (o tutorial usa eu1)
TTN_REGIAO=eu1

# Opcional: ID do dispositivo (end device). Deixe "+" para aceitar qualquer um da aplicação.
TTN_DEVICE_ID=+

# Porta LoRaWAN dos pacotes do contador (a mesma do demo_visitantes.ino)
PORTA_LORAWAN=3

# Porta da página no navegador
PORTA_WEB=8001
